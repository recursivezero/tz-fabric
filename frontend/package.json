  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npm run lint:biome && npm run lint:eslint",
    "fix": " biome format . --write",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','build']) fs.rmSync(path,{recursive:true,force:true});\"",
    "nuke": "node -e \"const fs=require('node:fs'); fs.rmSync('node_modules',{recursive:true,force:true});\" && npm run clean",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "vite preview --host 0.0.0.0 --port 5173"
  },
