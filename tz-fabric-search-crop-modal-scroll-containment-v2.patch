--- a/frontend/src/assets/styles/SeniorUiFixes.css
+++ b/frontend/src/assets/styles/SeniorUiFixes.css
@@ -2287,3 +2287,104 @@
     font-size: 0.92rem;
   }
 }
+
+/* ============================================================
+   Search crop dialog viewport recovery
+   ============================================================
+   Keep the complete dialog reachable on short viewports. The modal remains
+   centered when it fits; when it is taller than the viewport it begins at
+   the top and the overlay becomes the scroll container. */
+:root[data-theme]
+  .fabric-search-modal-root.fabric-search
+  > .crop-drawer.crop-drawer {
+  width: auto !important;
+  height: auto !important;
+  max-height: none !important;
+  align-items: flex-start !important;
+  justify-content: center !important;
+  overflow-x: hidden !important;
+  overflow-y: auto !important;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+  -webkit-overflow-scrolling: touch;
+  touch-action: pan-y;
+}
+
+:root[data-theme]
+  .fabric-search-modal-root.fabric-search
+  > .crop-drawer.crop-drawer
+  > .crop-drawer__inner {
+  box-sizing: border-box;
+  width: min(720px, calc(100vw - 24px)) !important;
+  max-width: calc(100vw - 24px) !important;
+  height: auto !important;
+  min-height: 0 !important;
+  max-height: calc(100dvh - 20px) !important;
+  margin-block: auto !important;
+  margin-inline: 0 !important;
+  overflow: hidden !important;
+  flex: 0 1 auto;
+}
+
+:root[data-theme]
+  .fabric-search-modal-root.fabric-search
+  .crop-drawer__stage {
+  flex: 1 1 auto;
+  height: auto !important;
+  min-height: 0 !important;
+  max-height: min(58dvh, calc(100dvh - 210px)) !important;
+  overflow: auto !important;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+
+:root[data-theme]
+  .fabric-search-modal-root.fabric-search
+  :is(.crop-drawer__image-wrap, .crop-drawer__image) {
+  max-width: 100% !important;
+  height: auto !important;
+  min-height: 0 !important;
+  max-height: min(56dvh, calc(100dvh - 230px)) !important;
+}
+
+:root[data-theme]
+  .fabric-search-modal-root.fabric-search
+  .crop-drawer__actions {
+  flex: 0 0 auto;
+}
+
+@media (max-height: 680px) {
+  :root[data-theme]
+    .fabric-search-modal-root.fabric-search
+    > .crop-drawer.crop-drawer {
+    align-items: flex-start !important;
+    padding: 8px !important;
+    overflow-y: auto !important;
+  }
+
+  :root[data-theme]
+    .fabric-search-modal-root.fabric-search
+    > .crop-drawer.crop-drawer
+    > .crop-drawer__inner {
+    height: auto !important;
+    min-height: 0 !important;
+    max-height: calc(100dvh - 16px) !important;
+    margin-block: 0 auto !important;
+    gap: 10px;
+    padding: 14px !important;
+  }
+
+  :root[data-theme]
+    .fabric-search-modal-root.fabric-search
+    .crop-drawer__stage {
+    height: auto !important;
+    min-height: 0 !important;
+    max-height: calc(100dvh - 170px) !important;
+  }
+
+  :root[data-theme]
+    .fabric-search-modal-root.fabric-search
+    :is(.crop-drawer__image-wrap, .crop-drawer__image) {
+    max-height: calc(100dvh - 190px) !important;
+  }
+}
