ENVIRONMENT="development"
API_PREFIX = "/api/v1"
PORT=8002
DATABASE_URI="mongodb://<username>:<password>@127.0.0.1:27017/<db>?authSource=admin&retryWrites=true&w=majority"
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxx"
INTERNAL_API_KEY="replace-with-output-of-openssl-rand-hex-24"
ALLOW_LOCAL_ORIGINS="true/false"

# LanceDB Admin Explorer local mode uses the application DATABASE_PATH
# (backend/database by default). No browser-provided local path is required.

# Amazon S3 / production object storage. If the admin-page S3 URI is blank,
# the LanceDB explorer scans AWS_BUCKET_NAME.
#for production
AWS_ARN="arn:aws:iam::012345678901:user/<whoever>"
AWS_ACCESS_KEY_ID="****"
AWS_SECRET_ACCESS_KEY="***"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="bucket-name"
AWS_PUBLIC_URL="https://assets.threadzip.com"

# Cloudflare R2. If the admin-page R2 URI is blank, the explorer scans
# R2_BUCKET_NAME. R2_ENDPOINT is backend connection configuration; do not paste
# the HTTPS endpoint into the admin-page URI field (which uses s3:// syntax).
R2_ACCESS_KEY_ID="****"
R2_SECRET_ACCESS_KEY="****"
R2_ACCOUNT_ID="*****"
R2_BUCKET_NAME="r2-bucket-name"
R2_PUBLIC_CDN="https://assets.threadzip.com"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"
